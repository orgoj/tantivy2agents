#!/usr/bin/env python3
import os, sys, json, yaml, re, shutil
import tantivy

INDEX_DIR = ".tantivy/idx"

def parse_markdown(path):
    """Vrátí dict připravený pro Tantivy z Markdown souboru"""
    text = open(path, encoding="utf-8").read()
    meta = {}
    body = text

    # Najdi YAML header mezi ---
    m = re.match(r"^---\n(.*?)\n---\n(.*)$", text, re.S)
    if m:
        header, body = m.groups()
        meta = yaml.safe_load(header) or {}
    
    # Pro servers/*.md bez headerů vytvoř metadata ze jména souboru
    if not meta and path.startswith("servers/"):
        server_name = os.path.splitext(os.path.basename(path))[0]
        servers = [server_name]
        
        # Pokud název končí číslicí, přidej i základní jméno bez čísla
        # např. mp1 -> přidá také "mp", ferda7 -> přidá také "ferda"
        if re.search(r'\d+$', server_name):
            base_name = re.sub(r'\d+$', '', server_name)
            if base_name and base_name != server_name:
                servers.append(base_name)
        
        meta = {
            "servers": servers,
            "tags": ["server", "infrastructure"],
        }

    # Titulek = první H1 (# ...)
    title = None
    for line in body.splitlines():
        if line.startswith("# "):
            title = line[2:].strip()
            break

    return {
        "title": title or os.path.basename(path),
        "body": body,
        "tags": " ".join(meta.get("tags", [])) if isinstance(meta.get("tags"), list) else meta.get("tags", "") or "",
        "servers": " ".join(meta.get("servers", [])) if isinstance(meta.get("servers"), list) else meta.get("servers", "") or "",
        "path": path
    }

def main():
    # Default directories if none provided
    if len(sys.argv) < 2:
        directories = ["guides", "servers", "incidents"]
    else:
        directories = sys.argv[1:]

    print(f"Indexing directories: {', '.join(directories)}")

    # Smaž starý index
    if os.path.exists(INDEX_DIR):
        shutil.rmtree(INDEX_DIR)
    os.makedirs(INDEX_DIR, exist_ok=True)

    # Projdi všechny adresáře a připrav dokumenty
    docs = []
    for rootdir in directories:
        if not os.path.exists(rootdir):
            print(f"Warning: Directory {rootdir} does not exist, skipping")
            continue
        
        for root, dirs, files in os.walk(rootdir):
            for f in files:
                if f.endswith(".md"):
                    path = os.path.join(root, f)
                    doc = parse_markdown(path)
                    docs.append(doc)

    if not docs:
        print("No markdown files found to index")
        sys.exit(1)

    print(f"Creating tantivy index with {len(docs)} documents...")
    
    # Vytvoř tantivy schéma
    schema_builder = tantivy.SchemaBuilder()
    schema_builder.add_text_field("title", stored=True, tokenizer_name="en_stem")
    schema_builder.add_text_field("body", stored=True, tokenizer_name="en_stem") 
    schema_builder.add_text_field("tags", stored=True, tokenizer_name="en_stem")
    schema_builder.add_text_field("servers", stored=True, tokenizer_name="en_stem")
    schema_builder.add_text_field("path", stored=True, tokenizer_name="raw")
    schema = schema_builder.build()
    
    # Vytvoř index
    index = tantivy.Index(schema, path=INDEX_DIR)
    
    # Indexuj dokumenty přímo
    writer = index.writer()
    for doc_data in docs:
        writer.add_document(tantivy.Document(
            title=doc_data["title"],
            body=doc_data["body"], 
            tags=doc_data["tags"],
            servers=doc_data["servers"],
            path=doc_data["path"]
        ))
    writer.commit()
    
    print(f"✓ Zpracováno {len(docs)} dokumentů, index v {INDEX_DIR}")
    print("You can now search with: ./bin/tantivy-search 'your query'")

if __name__ == "__main__":
    main()