#!/usr/bin/env python3
import sys, argparse, json, yaml, re, os, subprocess
import tantivy

INDEX_DIR = ".tantivy/idx"

def load_doc_metadata(file_path):
    """Load YAML metadata from markdown file"""
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read()
        
        # Parse YAML header
        match = re.match(r"^---\n(.*?)\n---\n", content, re.S)
        if match:
            header = match.group(1)
            return yaml.safe_load(header) or {}
    except Exception:
        pass
    return {}

def filter_incidents(results, query_string, debug=False):
    """Filter out incidents files unless 'incident' keyword is in query"""
    query_words = set(query_string.lower().split())
    
    # If query contains 'incident', show all results (including incidents)
    if 'incident' in query_words:
        return results
    
    filtered = []
    filtered_out = []
    
    for score, doc_address, doc in results:
        file_path = doc["path"][0]
        
        # Filter out incidents files if 'incident' not in query
        if file_path.startswith("incidents/"):
            filtered_out.append((file_path, "incidents folder", score))
            continue
        
        filtered.append((score, doc_address, doc))
    
    if debug and filtered_out:
        print("DEBUG: Filtered out incidents files (no 'incident' keyword in query):")
        for path, reason, score in filtered_out:
            print(f"  {path} [score:{score:.3f}] - reason: {reason}")
        print()
    
    return filtered

def filter_by_required_keywords(results, query_string, debug=False):
    """Filter results by required_keywords metadata"""
    query_words = set(query_string.lower().split())
    filtered = []
    filtered_out = []
    
    for score, doc_address, doc in results:
        file_path = doc["path"][0]
        metadata = load_doc_metadata(file_path)
        
        required = metadata.get("required_keywords", [])
        if required:
            # Check if ANY required keyword is in query
            if not any(kw.lower() in query_words for kw in required):
                filtered_out.append((file_path, required, score))
                continue  # Skip this document
        
        filtered.append((score, doc_address, doc))
    
    if debug and filtered_out:
        print("DEBUG: Filtered out documents:")
        for path, required_kw, score in filtered_out:
            print(f"  {path} [score:{score:.3f}] - required: {required_kw}")
        print()
    
    return filtered

def ensure_index_exists(debug=False):
    """Automatically create index if it doesn't exist"""
    if not os.path.exists(INDEX_DIR):
        if debug:
            print("Tantivy index not found, creating new index...")
        try:
            # Run tantivy-index script
            result = subprocess.run(
                [sys.executable, "./bin/tantivy-index"], 
                capture_output=True, 
                text=True, 
                check=True
            )
            if debug:
                print(result.stdout)
            return True
        except subprocess.CalledProcessError as e:
            print(f"Failed to create index: {e}")
            print(f"Error output: {e.stderr}")
            return False
        except FileNotFoundError:
            print("Error: ./bin/tantivy-index not found")
            return False
    return True

def main():
    parser = argparse.ArgumentParser(description='Search in tantivy index')
    parser.add_argument('query', nargs='+', help='Search query')
    parser.add_argument('-r', '--results', type=int, default=10, 
                        help='Number of results to return (default: 10)')
    parser.add_argument('--debug', action='store_true',
                        help='Show what documents were filtered out')
    
    args = parser.parse_args()
    query_string = " ".join(args.query)
    
    # Ensure index exists, create if necessary
    if not ensure_index_exists(args.debug):
        sys.exit(1)
    
    try:
        # Load index
        index = tantivy.Index.open(INDEX_DIR)
        searcher = index.searcher()
        
        # Parse query
        query_parser = index.parse_query(query_string, ["title", "body", "tags", "servers"])
        query = query_parser
        
        # Search with 4x limit to allow for filtering
        search_limit = args.results * 4
        result = searcher.search(query, search_limit)
        
        if not result.hits:
            print("No results found.")
            return
            
        # Prepare results with docs for filtering
        results_with_docs = []
        for score, doc_address in result.hits:
            doc = searcher.doc(doc_address)
            results_with_docs.append((score, doc_address, doc))
        
        # First filter incidents files (unless 'incident' in query)
        after_incidents_filter = filter_incidents(results_with_docs, query_string, args.debug)
        
        # Then filter by required_keywords
        final_results = filter_by_required_keywords(after_incidents_filter, query_string, args.debug)
        
        if not final_results:
            print("No results found after filtering.")
            return
        
        # Print results (ensure we don't exceed requested limit)
        for score, doc_address, doc in final_results[:args.results]:
            path = doc["path"][0]
            print(f"{path} [score:{score:.3f}]")
            
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()