#!/usr/bin/env python3
import json
import sys
import subprocess
import os

# Read JSON data from stdin
try:
    data = json.load(sys.stdin)
except json.JSONDecodeError:
    sys.exit(0)  # Exit silently if no valid JSON

# Get file path from tool input
file_path = data.get("tool_input", {}).get("file_path", "")

if not file_path:
    sys.exit(0)  # No file path, nothing to do

# Check if file is in guides/, servers/, or incidents/ directory
if "/guides/" in file_path or "/servers/" in file_path or "/incidents/" in file_path:
    # Get repository root from CLAUDE_PROJECT_DIR
    project_dir = os.environ.get("CLAUDE_PROJECT_DIR", "")
    if project_dir:
        # Run tantivy-clear script
        try:
            subprocess.run(
                [os.path.join(project_dir, "bin", "tantivy-clear")],
                check=True
            )
        except subprocess.CalledProcessError:
            pass  # Ignore errors

sys.exit(0)  # Always exit successfully